# Neon Postgres connection string (https://neon.tech — free tier is plenty)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Polygon RPC for server-side balance and log reads.
# The public default works; swap for an Alchemy URL before launch.
POLYGON_RPC_URL="https://polygon-bor-rpc.publicnode.com"

# Protects the sweep endpoint. Generate with: openssl rand -hex 24
CRON_SECRET="replace-me"
